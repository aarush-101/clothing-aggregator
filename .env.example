# ---------------------------------------------------------------------------
# Clothing Aggregator - example environment
#
# Copy to `.env` in the repo root for docker-compose, and/or to
# `apps/api/.env` for the FastAPI app. Frontend values live in
# `apps/web/.env.local` (only NEXT_PUBLIC_* values are sent to the browser).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                  # console | json  (use json in production)
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL -------------------------------------------------------------
# Local docker-compose default. For Supabase/Neon use their pooled connection
# string and keep `+asyncpg`, e.g.
#   postgresql+asyncpg://user:pass@ep-xxx.ap-southeast-2.aws.neon.tech/neondb
# Leave blank to run with an ephemeral SQLite file (search still works fully;
# only persistence of favourites/analytics is affected).
DATABASE_URL=postgresql+asyncpg://aggregator:aggregator@localhost:5432/aggregator

# --- Redis ------------------------------------------------------------------
# Local docker-compose default. For Upstash use the rediss:// URL:
#   rediss://default:<password>@<region>.upstash.io:6379
# Leave blank to fall back to an in-process cache (single instance only).
REDIS_URL=redis://localhost:6379/0

# --- Anthropic (natural-language query parsing) -----------------------------
# Optional. Without a key the deterministic fallback parser is used.
ANTHROPIC_API_KEY=
# Set to claude-haiku-4-5 for the lowest query-parsing latency.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=12
ANTHROPIC_MAX_TOKENS=4000

# --- Search behaviour -------------------------------------------------------
SEARCH_MAX_QUERY_LENGTH=400
SEARCH_MAX_CONCURRENT_RETAILERS=6
SEARCH_RETAILER_TIMEOUT_SECONDS=8
SEARCH_TOTAL_TIMEOUT_SECONDS=25
SEARCH_RETAILER_MAX_ATTEMPTS=2
SEARCH_MAX_RESULTS=120

# --- Cache lifetimes --------------------------------------------------------
CACHE_FRESH_SECONDS=1800            # 30 minutes
CACHE_MAX_STALE_SECONDS=86400       # 24 hours
CACHE_INTENT_TTL_SECONDS=86400
CACHE_LOCK_TIMEOUT_SECONDS=30

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCHES_PER_MINUTE=20
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Connectors -------------------------------------------------------------
# Comma-separated connector keys. "mock:*" enables all bundled mock retailers.
ENABLED_CONNECTORS=mock:*,sample_feed
# Adds a deliberately failing mock retailer so partial-result handling is
# visible in the demo. Safe to leave on in development.
MOCK_INCLUDE_FLAKY_RETAILER=true
MOCK_LATENCY_MULTIPLIER=1.0

# Generic affiliate feed connectors (JSON or XML). Array of feed configs.
# `url` accepts https:// or a file path for local testing.
# See docs/adding-a-connector.md for the full field mapping reference.
AFFILIATE_FEEDS=[]

# Example public/configurable retailer connector. Off by default because it
# depends on a third-party demo API being reachable.
ENABLE_EXAMPLE_PUBLIC_CONNECTOR=false
EXAMPLE_PUBLIC_API_BASE_URL=https://fakestoreapi.com

# HTML connectors are OFF unless you have written permission from the
# retailer. See docs/adding-a-connector.md before enabling.
ENABLE_HTML_CONNECTORS=false

# --- Affiliate link tracking ------------------------------------------------
AFFILIATE_SUBID_PREFIX=ca
# JSON map of retailer key -> affiliate template. `{url}` is replaced with the
# URL-encoded destination, `{subid}` with the click-tracking id.
# e.g. {"northbound":"https://www.awin1.com/cread.php?awinmid=1234&awinaffid=999&clickref={subid}&ued={url}"}
AFFILIATE_TEMPLATES={}

# --- Frontend (apps/web/.env.local) ----------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
