# Marle: copy to .env at the repository root.
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Blank uses persistent apps/api/marle.sqlite3 and creates tables automatically.
# PostgreSQL example (run make migrate before starting):
# DATABASE_URL=postgresql+asyncpg://aggregator:aggregator@localhost:5432/aggregator
DATABASE_URL=
# Blank uses an in-process cache. Required alongside DATABASE_URL in production.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Optional natural-language parser. No key uses deterministic keyword parsing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=12
ANTHROPIC_MAX_TOKENS=4000

SEARCH_MAX_QUERY_LENGTH=400
SEARCH_MAX_RESULTS=120
CACHE_INTENT_TTL_SECONDS=86400
CACHE_SNAPSHOT_TTL_SECONDS=3600

# Auto-collect enabled registry sources in the API process.
# Set false on the API when running make worker separately.
INGESTION_ENABLED=true
INGESTION_POLL_SECONDS=60
CATALOGUE_STALE_SECONDS=43200
CATALOGUE_EXPIRE_SECONDS=172800
# Per-retailer refresh intervals/page budgets live in app/data/retailers.json.

RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCHES_PER_MINUTE=20
RATE_LIMIT_REQUESTS_PER_MINUTE=120

AFFILIATE_SUBID_PREFIX=ca
AFFILIATE_TEMPLATES={}

# Put frontend settings in apps/web/.env.local (compiled into the browser build).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
